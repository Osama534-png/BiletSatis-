      }
    },

    "yuktest": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5052",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",

        "//": "k6 yük testleri tek IP'den yüzlerce kayıt/giriş isteği gönderir ve test hesaplarının gelen kutusu olmadığı için doğrulama adımını tamamlayamaz. Bu iki koruma yalnızca bu profilde kapalıdır; normal 'http' profilinde açıktır.",
        "Guvenlik__EpostaDogrulamaZorunlu": "false",
        "Guvenlik__HizSiniriAktif": "false"
      }
