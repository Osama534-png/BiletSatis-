@model BiletSatis.Web.Models.AnaSayfaVm
@using BiletSatis.Web.Domain

@functions {
    // Kategori menüsündeki çizgi ikonlar (24x24, stroke currentColor).
    static string KategoriIkonu(EtkinlikKategorisi? kategori) => kategori switch
    {
        null => "<path d='M3 17l6-6 4 4 7-7'/><path d='M17 7h4v4'/>",
        EtkinlikKategorisi.Konser => "<rect x='9' y='3' width='6' height='11' rx='3'/><path d='M5 11a7 7 0 0 0 14 0'/><path d='M12 18v3'/>",
        EtkinlikKategorisi.Tiyatro => "<path d='M5 5h14v7a7 7 0 0 1-14 0z'/><path d='M9.5 10h.01'/><path d='M14.5 10h.01'/><path d='M9.5 14q2.5 2 5 0'/>",
        EtkinlikKategorisi.Sinema => "<rect x='3' y='5' width='18' height='14' rx='2'/><path d='M7 5v14'/><path d='M17 5v14'/>",
        EtkinlikKategorisi.Festival => "<path d='M3 20l9-14 9 14z'/><path d='M12 6v14'/>",
        EtkinlikKategorisi.StandUp => "<circle cx='12' cy='7' r='4'/><path d='M12 11v6'/><path d='M8 21h8'/>",
        EtkinlikKategorisi.ElektronikMuzik => "<path d='M4 14v-2a8 8 0 0 1 16 0v2'/><rect x='2' y='14' width='4' height='6' rx='2'/><rect x='18' y='14' width='4' height='6' rx='2'/>",
        EtkinlikKategorisi.CocukAktiviteleri => "<path d='M12 3a5 5 0 0 1 5 5c0 3.5-5 8-5 8s-5-4.5-5-8a5 5 0 0 1 5-5z'/><path d='M12 16v3'/><path d='M10.5 21h3'/>",
        EtkinlikKategorisi.Eglence => "<path d='M12 3l2 6 6 2-6 2-2 6-2-6-6-2 6-2z'/>",
        _ => "<circle cx='12' cy='12' r='8'/>"
    };
}

@{
    ViewData["Title"] = "Etkinlikler";
    var filtre = Model.Filtre;
    var sayfa = Model.Sayfa;
    var fiyatTavan = (int)Model.FiyatTavani;
    var secilenFiyat = (int)(filtre.EnYuksekFiyat ?? Model.FiyatTavani);
}

<div class="hero">
    <svg class="hero-float f1" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-4V8Z" stroke="currentColor" stroke-width="1.4"/>
        <path d="M14 6v12" stroke="currentColor" stroke-width="1.4" stroke-dasharray="2 2"/>
    </svg>
    <svg class="hero-float f2" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2 14.5 9.5 22 12 14.5 14.5 12 22 9.5 14.5 2 12 9.5 9.5 12 2Z" stroke="currentColor" stroke-width="1.2"/>
    </svg>
    <svg class="hero-float f3" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.4"/>
        <path d="M8.5 12.5 10.5 14.5 15.5 9.5" stroke="currentColor" stroke-width="1.4"/>
    </svg>

    <span class="eyebrow">✦ Canlı Etkinlikler</span>
    <h1>Biletini Kap, Sahneye Yaklaş!</h1>
    <p>En sıcak etkinlikler burada — sepete ekle, öde, ya da kuyruğa katılıp şansını dene.</p>
</div>

@if (Model.Sehirler.Any())
{
    <div class="city-row">
        <details class="city-picker" id="cityPicker">
            <summary>
                <span class="city-pin">📍</span>
                <span class="city-current" id="cityCurrent">@(string.IsNullOrWhiteSpace(filtre.Sehir) ? "Tüm Şehirler" : filtre.Sehir)</span>
                <span class="city-caret" aria-hidden="true">▾</span>
            </summary>
            <div class="city-menu" role="listbox">
                @{
                    var sehirsizDegerler = filtre.BaglantiDegerleri(1);
                    sehirsizDegerler.Remove("sehir");
                }
                <a class="city-option @(string.IsNullOrWhiteSpace(filtre.Sehir) ? "is-active" : "")"
                   asp-action="Index" asp-all-route-data="sehirsizDegerler" role="option">Tüm Şehirler</a>
                @foreach (var sehir in Model.Sehirler)
                {
                    var sehirDegerleri = filtre.BaglantiDegerleri(1);
                    sehirDegerleri["sehir"] = sehir;
                    <a class="city-option @(filtre.Sehir == sehir ? "is-active" : "")"
                       asp-action="Index" asp-all-route-data="sehirDegerleri" role="option">@sehir</a>
                }
            </div>
        </details>
        <span class="city-hint">Şehir seçerek listeyi daraltabilirsin</span>
    </div>
}

@* Kategori seçimi artık sunucuda filtreleniyor; her sekme kendi adresine giden
   bir bağlantı. Böylece seçim paylaşılabilir ve geri düğmesi çalışır. *@
<nav class="category-nav" aria-label="Etkinlik kategorileri">
    @{
        var kategorisizDegerler = filtre.BaglantiDegerleri(1);
        kategorisizDegerler.Remove("kategori");
    }
    <a class="category-tab @(filtre.Kategori is null ? "is-active" : "")"
       asp-action="Index" asp-all-route-data="kategorisizDegerler">
        <svg viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(KategoriIkonu(null))</svg>
        <span>Tümü</span>
    </a>
    @foreach (var kategori in KategoriMetni.Tumu)
    {
        var kategoriDegerleri = filtre.BaglantiDegerleri(1);
        kategoriDegerleri["kategori"] = kategori.ToString();
        <a class="category-tab @(filtre.Kategori == kategori ? "is-active" : "")"
           asp-action="Index" asp-all-route-data="kategoriDegerleri">
            <svg viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(KategoriIkonu(kategori))</svg>
            <span>@KategoriMetni.Ad(kategori)</span>
        </a>
    }
</nav>

<div class="stats-strip">
    <div class="stat-tile reveal">
        <div class="stat-icon">🎪</div>
        <div class="stat-value" data-count="@Model.ToplamEtkinlik">0</div>
        <div class="stat-label">Etkinlik</div>
    </div>
    <div class="stat-tile reveal">
        <div class="stat-icon">🎟️</div>
        <div class="stat-value" data-count="@Model.ToplamSatistaBilet">0</div>
        <div class="stat-label">Satıştaki Bilet</div>
    </div>
    <div class="stat-tile reveal">
        <div class="stat-icon">⏳</div>
        <div class="stat-value" data-count="@Model.ToplamKuyruktaBekleyen">0</div>
        <div class="stat-label">Kuyrukta Bekleyen</div>
    </div>
</div>

@if (Model.OneCikanlar.Any())
{
    var vitrin = Model.OneCikanlar;
    <section class="showcase">
        <div class="section-head">
            <h2>Günün Öne Çıkanları</h2>
        </div>
        <div class="showcase-wrap">
            <div class="showcase-rail" id="showcaseRail">
                @for (int i = 0; i < vitrin.Count; i++)
                {
                    var e = vitrin[i];
                    var afis = string.IsNullOrWhiteSpace(e.AfisUrl) ? "/img/afis/varsayilan.svg" : e.AfisUrl;
                    <a class="showcase-item" asp-controller="Etkinlik" asp-action="Detay" asp-route-id="@e.Id">
                        <span class="showcase-top">
                            <span class="showcase-rank">@(i + 1)</span>
                            <img class="showcase-poster" src="@afis" alt="@e.Ad afişi" loading="lazy" />
                        </span>
                        <span class="showcase-name">@e.Ad</span>
                        <span class="showcase-date">@e.Tarih.ToString("dd MMM yyyy")@(string.IsNullOrWhiteSpace(e.Mekan) ? "" : $" · {e.Mekan.Split(',').Last().Trim()}")</span>
                    </a>
                }
            </div>
            <button type="button" class="rail-nav rail-prev" id="showcasePrev" aria-label="Geri kaydır">‹</button>
            <button type="button" class="rail-nav rail-next" id="showcaseNext" aria-label="İleri kaydır">›</button>
        </div>
    </section>
}

<div class="browse-layout">
    @* Filtreler artık sunucuda uygulanıyor: form GET ile gönderilir, seçimler
       adres çubuğunda durur. Böylece hem paylaşılabilir hem de tarayıcı geçmişiyle
       uyumlu olur — ve sunucu her istekte yalnızca ilgili sayfayı okur. *@
    <form class="filter-panel" method="get" asp-action="Index" id="filtrePaneli">
        <input type="hidden" name="kategori" value="@(filtre.Kategori?.ToString() ?? "")" />
        <input type="hidden" name="sehir" value="@filtre.Sehir" />

        <div class="filter-group">
            <h3>Ara</h3>
            <div class="search-bar">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6"/>
                    <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
                <input type="text" name="arama" value="@filtre.Arama" placeholder="Etkinlik adı..." autocomplete="off" />
            </div>
        </div>

        <div class="filter-group">
            <h3>Sırala</h3>
            <select name="siralama" class="form-select form-select-sm">
                <option value="tarih" selected="@(filtre.Siralama == "tarih")">Yaklaşan tarih</option>
                <option value="fiyat-artan" selected="@(filtre.Siralama == "fiyat-artan")">Fiyat: düşükten yükseğe</option>
                <option value="fiyat-azalan" selected="@(filtre.Siralama == "fiyat-azalan")">Fiyat: yüksekten düşüğe</option>
                <option value="isim" selected="@(filtre.Siralama == "isim")">İsim: A–Z</option>
            </select>
        </div>

        <div class="filter-group">
            <h3>Tarih</h3>
            <select name="tarih" class="form-select form-select-sm">
                <option value="tumu" selected="@(filtre.Tarih == "tumu")">Tümü</option>
                <option value="hafta" selected="@(filtre.Tarih == "hafta")">Bu Hafta</option>
                <option value="ay" selected="@(filtre.Tarih == "ay")">Bu Ay</option>
            </select>
        </div>

        <div class="filter-group">
            <h3>Fiyat Aralığı</h3>
            <div class="price-bars" aria-hidden="true">
                @for (int i = 0; i < 22; i++)
                {
                    <span data-yukseklik-px="@(18 + (i * 37 % 26))"></span>
                }
            </div>
            <input type="range" name="enYuksekFiyat" id="priceRange" class="price-slider"
                   min="0" max="@fiyatTavan" step="50" value="@secilenFiyat" />
            <div class="price-readout">
                <span>0 ₺</span>
                <strong id="priceValue">@secilenFiyat ₺</strong>
            </div>
        </div>

        <div class="filter-group">
            <h3>Durum</h3>
            <label class="check-row">
                <input type="checkbox" name="tukenenleriGoster" value="true" checked="@filtre.TukenenleriGoster" />
                <span>Tükenenleri göster</span>
            </label>
        </div>

        <button type="submit" class="btn btn-primary btn-sm w-100 mb-2">Filtrele</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">Filtreleri Temizle</a>
    </form>

    <section class="browse-main">
        <div class="section-head">
            <h2>Tüm Etkinlikler</h2>
            <div class="section-tools">
                <div class="view-toggle" id="viewToggle" role="group" aria-label="Görünüm">
                    <button type="button" class="view-btn is-active" data-view="grid" title="Izgara görünümü" aria-label="Izgara görünümü">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="3" width="8" height="8" rx="1.5" />
                            <rect x="13" y="3" width="8" height="8" rx="1.5" />
                            <rect x="3" y="13" width="8" height="8" rx="1.5" />
                            <rect x="13" y="13" width="8" height="8" rx="1.5" />
                        </svg>
                    </button>
                    <button type="button" class="view-btn" data-view="list" title="Liste görünümü" aria-label="Liste görünümü">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        @* Filtre değişince yalnızca bu kap yenilenir. *@
        <div id="sonuclar" aria-live="polite">
            <partial name="_EtkinlikSonuclari" model="Model" />
        </div>
    </section>
</div>
