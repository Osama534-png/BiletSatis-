@{
    ViewData["Title"] = "Bağlantı Gönderildi";
}

<div class="card auth-card">
    <div class="card-body text-center">
        <div class="durum-ikonu">📬</div>
        <h1 class="h3 mb-2">Bağlantı gönderildi</h1>
        <p class="text-muted mb-4">
            Girdiğiniz adres kayıtlıysa, şifre sıfırlama bağlantısını e-postanızda bulacaksınız.
            Bağlantı kısa süre sonra geçersiz olur.
        </p>
        <a asp-action="GirisYap" class="btn btn-primary">Giriş Sayfasına Dön</a>
    </div>
</div>
