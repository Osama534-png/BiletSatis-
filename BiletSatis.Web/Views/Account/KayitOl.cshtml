@model BiletSatis.Web.Models.KayitOlViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="card auth-card">
    <div class="card-body">
        <h1 class="h3 mb-1">🎉 Aramıza Katıl</h1>
        <p class="text-muted mb-4">Saniyeler içinde hesabını oluştur, bilet almaya başla.</p>

        <form asp-action="KayitOl" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Ad" class="form-label"></label>
                <input asp-for="Ad" class="form-control" autocomplete="name" />
                <span asp-validation-for="Ad" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Sifre" class="form-label"></label>
                <input asp-for="Sifre" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Sifre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SifreTekrar" class="form-label"></label>
                <input asp-for="SifreTekrar" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="SifreTekrar" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-2">Kayıt Ol</button>
            <a asp-action="GirisYap" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="btn btn-link w-100">Zaten hesabınız var mı? Giriş Yap</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
