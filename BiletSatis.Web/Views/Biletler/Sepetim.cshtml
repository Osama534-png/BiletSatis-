@model List<BiletSatis.Web.Domain.Bilet>
@{
    ViewData["Title"] = "Sepetim";
}

<div class="hero">
    <h1>🛒 Sepetim</h1>
    <p>Ödeme bekleyen rezervasyonlarınız burada listelenir.</p>
</div>

@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">⚠️ @TempData["Hata"]</div>
}
@if (TempData["Bilgi"] != null)
{
    <div class="alert alert-success">✅ @TempData["Bilgi"]</div>
}

@if (!Model.Any())
{
    <p class="text-muted">Sepetinizde bekleyen bir rezervasyon yok.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Etkinliklere Göz At</a>
}
else
{
    var toplam = Model.Sum(b => b.Fiyat);
    var ilkBitis = Model.Min(b => b.KilitBitisZamani);

    <div class="row g-3">
        @foreach (var bilet in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="ticket-card reveal">
                    <div class="ticket-band band-sepette">
                        <div>
                            <div class="ticket-title">@bilet.Etkinlik?.Ad</div>
                        </div>
                        <span class="ticket-seat" style="font-size:1.15rem">@bilet.KoltukNo</span>
                    </div>
                    <div class="ticket-perf"></div>
                    <div class="ticket-body">
                        <div class="ticket-price-row">
                            <span class="ticket-price">@bilet.Fiyat.ToString("C")</span>
                        </div>
                        <form asp-action="IptalEt" method="post">
                            <input type="hidden" name="biletId" value="@bilet.Id" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Vazgeç</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="selection-bar mt-3">
        <div class="selection-info">
            <span class="selection-count">@Model.Count koltuk</span>
            <span class="selection-seats">@string.Join(" · ", Model.Select(b => b.KoltukNo))</span>
        </div>
        <div class="selection-total">
            <span class="selection-total-label">Toplam</span>
            <span class="selection-total-value">@toplam.ToString("C")</span>
        </div>
        <form asp-action="SepetiOde" method="post">
            <button type="submit" class="btn btn-primary">💳 Stripe ile Öde</button>
        </form>
    </div>

    <p class="ticket-desc mt-2">
        ⏱️ Rezervasyonunuz <strong>@ilkBitis?.ToLocalTime().ToString("HH:mm:ss")</strong> zamanına kadar geçerli —
        süre dolarsa koltuklar otomatik olarak tekrar satışa açılır. Ödemeye geçtiğinizde süre uzatılır.
    </p>
}
