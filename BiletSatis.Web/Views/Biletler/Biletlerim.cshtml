@model List<BiletSatis.Web.Domain.Bilet>
@{
    ViewData["Title"] = "Biletlerim";
    var gradients = new[]
    {
        "linear-gradient(135deg, #ff4d2e, #e8ac2e)",
        "linear-gradient(135deg, #1f8a70, #17140f)",
        "linear-gradient(135deg, #d93a1e, #7a2e12)",
        "linear-gradient(135deg, #e8ac2e, #ff4d2e)",
        "linear-gradient(135deg, #241f17, #1f8a70)",
    };
    var glyphs = new[] { "🎤", "🎸", "🎭", "🎶", "🥁", "🎻" };
}

<div class="hero">
    <h1>🎫 Biletlerim</h1>
    <p>Satın aldığınız biletlerin geçmişi.</p>
</div>

@if (TempData["Bilgi"] != null)
{
    <div class="alert alert-success">✅ @TempData["Bilgi"]</div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">⚠️ @TempData["Hata"]</div>
}

@if (!Model.Any())
{
    <p class="text-muted">Henüz satın aldığınız bir bilet yok.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Etkinliklere Göz At</a>
}
else
{
    <div class="row g-3">
        @for (int i = 0; i < Model.Count; i++)
        {
            var bilet = Model[i];
            var gradient = gradients[i % gradients.Length];
            var glyph = glyphs[i % glyphs.Length];

            <div class="col-md-6 col-lg-4">
                <div class="ticket-card reveal">
                    <div class="ticket-band" data-arka-plan="@gradient">
                        <div>
                            <div class="ticket-title">@bilet.Etkinlik?.Ad</div>
                            <div class="ticket-date">📅 @bilet.Etkinlik?.Tarih.ToString("dd.MM.yyyy HH:mm")</div>
                        </div>
                        <span class="ticket-glyph">@glyph</span>
                        <span class="ticket-stamp">Satıldı</span>
                    </div>
                    <div class="ticket-perf"></div>
                    <div class="ticket-body">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="text-muted small fw-semibold">Koltuk</span>
                            <span class="ticket-seat ticket-seat-buyuk">@bilet.KoltukNo</span>
                        </div>
                        <p class="ticket-desc">Bu bilet size ait — girişte QR kodunuz kontrol edilecektir.</p>
                        <div class="ticket-price-row">
                            <span class="ticket-price">@bilet.Fiyat.ToString("C")</span>
                            <span class="badge badge-satildi">✅ Satıldı</span>
                        </div>
                        <div class="ticket-code" aria-hidden="true"></div>

                        @if (bilet.GirisYapildi)
                        {
                            <p class="text-muted small mb-0">🚪 Bu bilet kapıda okutuldu; devredilemez.</p>
                        }
                        @* Yerel saat: etkinlik tarihi takvim saatidir, an değil (bkz. BiletDevirServisi).
                           Sayfadaki bu kontrol, servisin uyguladığı kuralla aynı olmalı. *@
                        else if (bilet.Etkinlik != null && bilet.Etkinlik.Tarih <= DateTime.Now)
                        {
                            <p class="text-muted small mb-0">Etkinlik geçti.</p>
                        }
                        else
                        {
                            <details class="devir-alani">
                                <summary>🎁 Bileti devret</summary>
                                <p class="ticket-desc">
                                    Bilet devredildiğinde <strong>sizdeki QR geçersiz olur</strong> ve
                                    yeni sahibine yeni bir QR gönderilir. Bu işlem geri alınamaz.
                                </p>
                                <form asp-action="Devret" method="post" data-tek-gonderim="Devrediliyor…">
                                    <input type="hidden" name="biletId" value="@bilet.Id" />
                                    <label class="form-label small" for="alici-@bilet.Id">Alıcının e-posta adresi</label>
                                    <input type="email" name="aliciEposta" id="alici-@bilet.Id"
                                           class="form-control form-control-sm mb-2" required
                                           placeholder="arkadas@ornek.com" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Devret</button>
                                </form>
                            </details>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
