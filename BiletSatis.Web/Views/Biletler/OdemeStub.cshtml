@model BiletSatis.Web.Domain.Bilet
@{
    ViewData["Title"] = "Ödeme";
}

<div class="card auth-card">
    <div class="card-body">
        <h1 class="h3 mb-3">💳 Ödeme</h1>

        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Koltuk</span>
            <span class="seat-no">@Model.KoltukNo</span>
        </div>
        <div class="d-flex justify-content-between mb-3">
            <span class="text-muted">Fiyat</span>
            <span class="fw-bold">@Model.Fiyat.ToString("C")</span>
        </div>

        <div class="alert alert-danger">
            ⏱️ Rezervasyonunuz <strong>@Model.KilitBitisZamani?.ToLocalTime().ToString("HH:mm:ss")</strong> zamanına kadar geçerlidir.
        </div>

        <form asp-action="OdemeyiTamamla" method="post" class="d-grid mb-2">
            <input type="hidden" name="biletId" value="@Model.Id" />
            <button type="submit" class="btn btn-success">✅ Ödemeyi Tamamla (test)</button>
        </form>
        <form asp-action="IptalEt" method="post" class="d-grid">
            <input type="hidden" name="biletId" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-secondary">Vazgeç</button>
        </form>
    </div>
</div>
