@model BiletSatis.Web.Domain.Etkinlik
@using BiletSatis.Web.Domain
@{
    ViewData["Title"] = Model.Ad;
}

<div class="hero">
    <h1>🎤 @Model.Ad</h1>
    <p>📅 @Model.Tarih.ToString("dd.MM.yyyy HH:mm")</p>
</div>

@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">⚠️ @TempData["Hata"]</div>
}
@if (TempData["Bilgi"] != null)
{
    <div class="alert alert-success">✅ @TempData["Bilgi"]</div>
}

<div class="row g-3">
    @foreach (var bilet in Model.Biletler.OrderBy(b => b.KoltukNo))
    {
        var (badgeClass, badgeIcon) = bilet.Durum switch
        {
            BiletDurumu.Satista => ("badge-satista", "🟢"),
            BiletDurumu.Sepette => ("badge-sepette", "🛒"),
            _ => ("badge-satildi", "✅")
        };

        <div class="col-6 col-md-4 col-lg-3">
            <div class="seat-card d-flex flex-column">
                <div class="seat-no mb-1">@bilet.KoltukNo</div>
                <div class="fw-semibold mb-2">@bilet.Fiyat.ToString("C")</div>
                <span class="badge @badgeClass mb-3 align-self-start">@badgeIcon @bilet.Durum</span>

                @if (bilet.Durum == BiletDurumu.Satista)
                {
                    <form asp-action="SepeteEkle" method="post" class="mt-auto">
                        <input type="hidden" name="biletId" value="@bilet.Id" />
                        <button type="submit" class="btn btn-primary btn-sm w-100">Sepete Ekle</button>
                    </form>
                }
            </div>
        </div>
    }
</div>
