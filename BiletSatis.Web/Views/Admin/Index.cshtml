@model BiletSatis.Web.Models.AdminPanelVm
@using BiletSatis.Web.Domain
@{
    ViewData["Title"] = "Admin";
}

<div class="hero d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1>⚙️ Yönetim Paneli</h1>
        <p>Etkinlikleri yönet, satışları izle, kuyruktakilere hak tanı.</p>
    </div>
    <a asp-action="EtkinlikEkle" class="btn btn-outline-secondary bg-white">+ Yeni Etkinlik</a>
</div>

@if (TempData["Bilgi"] != null)
{
    <div class="alert alert-success mb-4">✅ @TempData["Bilgi"]</div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger mb-4">⚠️ @TempData["Hata"]</div>
}

<div class="admin-ozet">
    <div class="stat-tile">
        <div class="stat-icon">💰</div>
        <div class="stat-value">@Model.ToplamGelir.ToString("N0")₺</div>
        <div class="stat-label">Toplam Gelir</div>
    </div>
    <div class="stat-tile">
        <div class="stat-icon">🎫</div>
        <div class="stat-value">@Model.ToplamSatilan</div>
        <div class="stat-label">Satılan Bilet</div>
    </div>
    <div class="stat-tile">
        <div class="stat-icon">🟢</div>
        <div class="stat-value">@Model.ToplamSatista</div>
        <div class="stat-label">Satıştaki Bilet</div>
    </div>
    <div class="stat-tile">
        <div class="stat-icon">📊</div>
        <div class="stat-value">%@Model.DolulukYuzdesi</div>
        <div class="stat-label">Doluluk</div>
    </div>
    <div class="stat-tile">
        <div class="stat-icon">⏳</div>
        <div class="stat-value">@Model.ToplamKuyrukta</div>
        <div class="stat-label">Kuyrukta</div>
    </div>
</div>

@if (!Model.Etkinlikler.Any())
{
    <p class="text-muted">Henüz etkinlik yok. Yukarıdan yeni bir etkinlik oluşturun.</p>
}

@foreach (var e in Model.Etkinlikler)
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="admin-etkinlik-baslik">
                <div>
                    <h2 class="h4 mb-1">@e.Ad</h2>
                    <p class="text-muted small mb-0">
                        @KategoriMetni.Ad(e.Kategori) · @e.Tarih.ToString("dd.MM.yyyy HH:mm")
                        @if (!string.IsNullOrWhiteSpace(e.Mekan))
                        {
                            <text> · @e.Mekan</text>
                        }
                    </p>
                </div>
                <div class="admin-etkinlik-islem">
                    <a asp-action="EtkinlikDuzenle" asp-route-id="@e.EtkinlikId" class="btn btn-outline-secondary btn-sm">✏️ Düzenle</a>
                    @if (e.Silinebilir)
                    {
                        @* Onay site.js'te soruluyor: satır içi onsubmit CSP altında çalışmaz. *@
                        <form asp-action="EtkinlikSil" method="post"
                              data-onay="@e.Ad etkinliği ve tüm biletleri silinecek. Emin misiniz?">
                            <input type="hidden" name="etkinlikId" value="@e.EtkinlikId" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">🗑️ Sil</button>
                        </form>
                    }
                    else
                    {
                        <span class="silme-kilidi" title="Satılmış bilet bulunan etkinlikler silinemez">🔒 Silinemez</span>
                    }
                </div>
            </div>

            <div class="admin-gelir-serit">
                <div>
                    <span class="etiket">Gelir</span>
                    <span class="tutar">@e.Gelir.ToString("N0")₺</span>
                </div>
                <div class="doluluk-cubugu" title="@e.SatildiSayisi / @e.ToplamKoltuk koltuk satıldı">
                    <div class="doluluk-dolu" data-genislik-yuzde="@e.DolulukYuzdesi"></div>
                </div>
                <span class="doluluk-yazi">%@e.DolulukYuzdesi doluluk</span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="stat-tile">
                        <div class="stat-value deger-basari">@e.SatistaSayisi</div>
                        <div class="text-muted small">Satışta</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-tile">
                        <div class="stat-value deger-uyari">@e.SepetteSayisi</div>
                        <div class="text-muted small">Sepette</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-tile">
                        <div class="stat-value">@e.SatildiSayisi</div>
                        <div class="text-muted small">Satıldı</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-tile">
                        <div class="stat-value deger-bilgi">@e.KuyrukBeklemede</div>
                        <div class="text-muted small">Kuyrukta Bekleyen</div>
                    </div>
                </div>
            </div>

            @if (e.SatildiSayisi > 0)
            {
                <div class="admin-gelir-serit">
                    <div>
                        <span class="etiket">Kapıdan geçen</span>
                        <span class="tutar">@e.GirisYapan / @e.SatildiSayisi</span>
                    </div>
                    <div class="doluluk-cubugu" title="@e.GirisYapan bilet sahibi giriş yaptı">
                        <div class="doluluk-dolu" data-genislik-yuzde="@e.GirisYuzdesi"></div>
                    </div>
                    <span class="doluluk-yazi">%@e.GirisYuzdesi giriş</span>
                </div>
            }

            <p class="text-muted small mb-2">Hak Tanındı: <strong>@e.KuyrukHakTanindi</strong> kişi</p>

            <form asp-action="SatisiBaslat" method="post" class="d-flex gap-2 align-items-center mb-3">
                <input type="hidden" name="etkinlikId" value="@e.EtkinlikId" />
                <label class="form-label mb-0">Satışı başlat:</label>
                <input type="number" name="n" value="@e.SatistaSayisi" min="1" class="form-control form-control-sm girdi-dar" />
                <button type="submit" class="btn btn-warning btn-sm">🚀 Başlat</button>
            </form>

            <hr />

            <form asp-action="BiletEkle" method="post" class="d-flex gap-2 align-items-end flex-wrap">
                <input type="hidden" name="etkinlikId" value="@e.EtkinlikId" />
                <div>
                    <label class="form-label mb-1 small">Koltuk Öneki</label>
                    <input type="text" name="koltukOnEki" value="B" maxlength="10" required class="form-control form-control-sm girdi-dar" />
                </div>
                <div>
                    <label class="form-label mb-1 small">Adet</label>
                    <input type="number" name="adet" value="10" min="1" max="1000" required class="form-control form-control-sm girdi-dar" />
                </div>
                <div>
                    <label class="form-label mb-1 small">Fiyat</label>
                    <input type="number" name="fiyat" value="250" min="1" step="0.01" required class="form-control form-control-sm girdi-orta" />
                </div>
                <button type="submit" class="btn btn-primary btn-sm">+ Bilet Ekle</button>
            </form>
        </div>
    </div>
}
