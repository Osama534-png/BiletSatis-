@model BiletSatis.Web.Models.EtkinlikEkleViewModel
@{
    ViewData["Title"] = "Yeni Etkinlik";
}

<div class="card auth-card">
    <div class="card-body">
        <h1 class="h3 mb-4">Yeni Etkinlik Oluştur</h1>

        <form asp-action="EtkinlikEkle" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Ad" class="form-label"></label>
                <input asp-for="Ad" class="form-control" />
                <span asp-validation-for="Ad" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Mekan" class="form-label"></label>
                <input asp-for="Mekan" class="form-control" placeholder="Örn: Harbiye Açıkhava, İstanbul" />
                <span asp-validation-for="Mekan" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Kategori" class="form-label"></label>
                <select asp-for="Kategori" class="form-select">
                    @foreach (var kategori in BiletSatis.Web.Domain.KategoriMetni.Tumu)
                    {
                        <option value="@kategori">@BiletSatis.Web.Domain.KategoriMetni.Ad(kategori)</option>
                    }
                </select>
                <span asp-validation-for="Kategori" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Aciklama" class="form-label"></label>
                <textarea asp-for="Aciklama" class="form-control" rows="4"
                          placeholder="Etkinlik detay sayfasında görünecek tanıtım metni"></textarea>
                <span asp-validation-for="Aciklama" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="YasSiniri" class="form-label"></label>
                <input asp-for="YasSiniri" type="number" min="0" max="21" class="form-control" />
                <span asp-validation-for="YasSiniri" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="AfisDosyasi" class="form-label"></label>
                <input asp-for="AfisDosyasi" type="file" class="form-control"
                       accept="image/jpeg,image/png,image/webp" />
                <div class="form-text">JPG, PNG veya WEBP · en fazla 4 MB. Boş bırakılırsa varsayılan afiş kullanılır.</div>
                <span asp-validation-for="AfisDosyasi" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Tarih" class="form-label"></label>
                <input asp-for="Tarih" class="form-control" />
                <span asp-validation-for="Tarih" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-2">Oluştur</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
