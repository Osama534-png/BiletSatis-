@model BiletSatis.Web.Models.EtkinlikDetayVm
@using BiletSatis.Web.Domain
@{
    ViewData["Title"] = Model.Ad;
    var afis = string.IsNullOrWhiteSpace(Model.AfisUrl) ? "/img/afis/varsayilan.svg" : Model.AfisUrl;
}

<nav class="breadcrumb-trail">
    <a asp-controller="Home" asp-action="Index">Etkinlikler</a>
    <span>›</span>
    <span>@KategoriMetni.Ad(Model.Kategori)</span>
    <span>›</span>
    <strong>@Model.Ad</strong>
</nav>

<section class="detay-hero">
    <img class="detay-afis" src="@afis" alt="@Model.Ad afişi" />

    <div class="detay-bilgi">
        <span class="detay-kategori">@KategoriMetni.Ad(Model.Kategori)</span>
        <h1>@Model.Ad</h1>

        <div class="detay-favori">
            <partial name="_FavoriDugmesi" model="@((Model.Id, Model.Favoride))" />
            <span class="text-muted small">@(Model.Favoride ? "Favorilerinizde" : "Favorilere ekle")</span>
        </div>

        @if (Model.Degerlendirmeler.Adet > 0)
        {
            <a class="puan-rozeti" href="#degerlendirmeler">
                <span class="puan-yildiz">★</span>
                <strong>@Model.Degerlendirmeler.Ortalama!.Value.ToString("0.0")</strong>
                <span class="puan-adet">(@Model.Degerlendirmeler.Adet değerlendirme)</span>
            </a>
        }

        <ul class="detay-meta">
            <li>
                <span class="meta-ikon">📅</span>
                <span>
                    <strong>@Model.Tarih.ToString("dd MMMM yyyy, dddd")</strong>
                    <small>Saat @Model.Tarih.ToString("HH:mm") · Kapılar 1 saat önce açılır</small>
                </span>
            </li>
            <li>
                <span class="meta-ikon">📍</span>
                <span>
                    <strong>@Model.MekanAdi</strong>
                    @if (!string.IsNullOrEmpty(Model.Sehir))
                    {
                        <small>@Model.Sehir</small>
                    }
                </span>
            </li>
            <li>
                <span class="meta-ikon">🎟️</span>
                <span>
                    @if (Model.Tukendi)
                    {
                        <strong>Tükendi</strong>
                        <small>Kuyruğa katılıp boşalan koltukları bekleyebilirsiniz</small>
                    }
                    else
                    {
                        <strong>@Model.MusaitKoltuk / @Model.ToplamKoltuk koltuk müsait</strong>
                        @if (Model.MusaitKoltuk <= 10)
                        {
                            <small class="kitlik">Son @Model.MusaitKoltuk bilet!</small>
                        }
                    }
                </span>
            </li>
        </ul>

        <div class="detay-fiyat-serit">
            <div>
                <span class="etiket">Bilet fiyatları</span>
                @if (Model.EnDusukFiyat.HasValue)
                {
                    <span class="tutar">@Model.EnDusukFiyat.Value.ToString("N0")₺ – @Model.EnYuksekFiyat!.Value.ToString("N0")₺</span>
                }
                else
                {
                    <span class="tutar">—</span>
                }
            </div>
            @if (Model.KalanGun > 0)
            {
                <span class="geri-sayim">⏳ @Model.KalanGun gün kaldı</span>
            }
        </div>

        <div class="detay-cta">
            @if (Model.SonaErdi)
            {
                @* Satın alma kapandı ama sayfa kapanmadı: aşağıdaki değerlendirmeler
                   okunabilir ve etkinliğe katılmış olanlar yorum bırakabilir. *@
                <p class="sona-erdi-bildirim">
                    Bu etkinlik sona erdi. Bilet satışı kapandı; aşağıdan katılanların
                    değerlendirmelerini okuyabilirsiniz.
                </p>
            }
            else if (Model.Tukendi)
            {
                <a asp-controller="Kuyruk" asp-action="Durum" asp-route-etkinlikId="@Model.Id"
                   class="btn btn-primary">⏳ Kuyruğa Katıl</a>
            }
            else
            {
                <a asp-controller="Biletler" asp-action="Index" asp-route-etkinlikId="@Model.Id"
                   class="btn btn-primary">🎟️ Bilet Al</a>
                <a asp-controller="Kuyruk" asp-action="Durum" asp-route-etkinlikId="@Model.Id"
                   class="btn btn-outline-secondary">⏳ Kuyruk</a>
            }
        </div>
    </div>
</section>

<div class="detay-govde">
    <div class="detay-sol">
        @if (!string.IsNullOrWhiteSpace(Model.Aciklama))
        {
            <section class="detay-blok">
                <h2>Etkinlik Hakkında</h2>
                <p class="detay-aciklama">@Model.Aciklama</p>
            </section>
        }

        <section class="detay-blok">
            <h2>Bilmeniz Gerekenler</h2>
            <ul class="bilgi-listesi">
                @if (Model.YasSiniri > 0)
                {
                    <li><span>🔞</span> Etkinlik <strong>@Model.YasSiniri yaş ve üzeri</strong> katılımcılar içindir.</li>
                }
                else
                {
                    <li><span>👨‍👩‍👧</span> Etkinlik <strong>her yaştan</strong> katılımcıya uygundur.</li>
                }
                <li><span>🎫</span> Salona giriş yalnızca bilet satın almış misafirlere aittir; biletinizi girişte hazır bulundurun.</li>
                <li><span>⏰</span> Kapılar etkinlikten 1 saat önce açılır. Geç kalan misafirler uygun bir arada içeri alınır.</li>
                <li><span>🪑</span> Biletiniz numaralı koltuk içerir; lütfen kendi koltuğunuzda oturun.</li>
                <li><span>📷</span> Profesyonel fotoğraf ve video ekipmanı ile girişe izin verilmemektedir.</li>
                <li><span>🎒</span> Yiyecek, içecek ve kesici alet ile girişe izin verilmemektedir.</li>
            </ul>
        </section>

        @if (Model.Fiyatlar.Any())
        {
            <section class="detay-blok">
                <h2>Kategoriler ve Fiyatlar</h2>
                <table class="table fiyat-tablosu">
                    <thead>
                        <tr>
                            <th>Blok</th>
                            <th>Kategori</th>
                            <th>Durum</th>
                            <th class="text-end">Fiyat</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.Fiyatlar)
                        {
                            <tr>
                                <td><strong>@f.Blok</strong></td>
                                <td>@f.Kategori</td>
                                <td>
                                    @if (f.MusaitKoltuk == 0)
                                    {
                                        <span class="badge badge-satildi">Tükendi</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-satista">@f.MusaitKoltuk müsait</span>
                                    }
                                </td>
                                <td class="text-end fiyat-hucre">@f.Fiyat.ToString("N0")₺</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
        <section class="detay-blok" id="degerlendirmeler">
            <h2>Değerlendirmeler</h2>

            @if (TempData["Bilgi"] != null)
            {
                <div class="alert alert-success">✅ @TempData["Bilgi"]</div>
            }
            @if (TempData["Hata"] != null)
            {
                <div class="alert alert-danger">⚠️ @TempData["Hata"]</div>
            }

            @if (Model.Degerlendirmeler.Adet == 0)
            {
                <p class="text-muted">Bu etkinlik henüz değerlendirilmedi.</p>
            }
            else
            {
                <div class="puan-ozet">
                    <div class="puan-ortalama">
                        <span class="puan-buyuk">@Model.Degerlendirmeler.Ortalama!.Value.ToString("0.0")</span>
                        <span class="puan-yildizlar">@(new string('★', (int)Math.Round(Model.Degerlendirmeler.Ortalama.Value)))</span>
                        <span class="puan-adet">@Model.Degerlendirmeler.Adet değerlendirme</span>
                    </div>
                    <div class="puan-dagilim">
                        @for (var p = 5; p >= 1; p--)
                        {
                            var adet = Model.Degerlendirmeler.Dagilim.TryGetValue(p, out var a) ? a : 0;
                            var oran = Model.Degerlendirmeler.Adet == 0 ? 0 : adet * 100 / Model.Degerlendirmeler.Adet;
                            <div class="dagilim-satiri">
                                <span class="dagilim-etiket">@p ★</span>
                                <span class="dagilim-cubuk"><span data-genislik-yuzde="@oran"></span></span>
                                <span class="dagilim-adet">@adet</span>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Model.DegerlendirebilirMi)
            {
                var mevcutPuan = Model.KendiDegerlendirmesi?.Puan ?? 0;

                <form asp-action="Degerlendir" method="post" class="degerlendirme-formu">
                    <input type="hidden" name="etkinlikId" value="@Model.Id" />

                    <p class="degerlendirme-baslik">
                        @(Model.KendiDegerlendirmesi == null ? "Bu etkinliği değerlendirin" : "Değerlendirmenizi güncelleyin")
                        <span class="katildi-rozeti">✔ Katıldınız</span>
                    </p>

                    <fieldset class="yildiz-secim">
                        <legend class="visually-hidden">Puanınız</legend>
                        @for (var p = 5; p >= 1; p--)
                        {
                            <input type="radio" name="puan" value="@p" id="puan-@p" checked="@(mevcutPuan == p)" required />
                            <label for="puan-@p" title="@p yıldız">★</label>
                        }
                    </fieldset>

                    <textarea name="yorum" class="form-control" rows="3"
                              maxlength="@BiletSatis.Web.Domain.Degerlendirme.EnUzunYorum"
                              placeholder="Nasıldı? (isteğe bağlı)">@Model.KendiDegerlendirmesi?.Yorum</textarea>

                    <button type="submit" class="btn btn-primary btn-sm mt-2">
                        @(Model.KendiDegerlendirmesi == null ? "Gönder" : "Güncelle")
                    </button>
                </form>
            }
            else if (Model.KendiDegerlendirmesi == null)
            {
                <p class="text-muted degerlendirme-kilit">
                    🔒 Değerlendirme yalnızca etkinliğe katılan misafirlere açıktır — biletiniz girişte okutulduğunda bu alan aktifleşir.
                </p>
            }

            @if (Model.Degerlendirmeler.Satirlar.Any())
            {
                <ul class="yorum-listesi">
                    @foreach (var y in Model.Degerlendirmeler.Satirlar)
                    {
                        <li class="yorum">
                            <div class="yorum-ust">
                                <span class="yorum-avatar">@(string.IsNullOrWhiteSpace(y.KullaniciAdi) ? "?" : y.KullaniciAdi.Trim()[..1].ToUpperInvariant())</span>
                                <div>
                                    <strong class="yorum-ad">@(string.IsNullOrWhiteSpace(y.KullaniciAdi) ? "Misafir" : y.KullaniciAdi)</strong>
                                    <span class="yorum-yildiz">@(new string('★', y.Puan))<span class="sonuk">@(new string('★', 5 - y.Puan))</span></span>
                                </div>
                                <time class="yorum-zaman" datetime="@y.Zaman.ToString("o")">
                                    @y.Zaman.ToLocalTime().ToString("dd.MM.yyyy")@(y.Duzenlendi ? " · düzenlendi" : "")
                                </time>
                            </div>
                            <p class="yorum-izledi">
                                @Model.Tarih.ToString("dd MMMM yyyy HH:mm") tarihinde @Model.MekanAdi mekanında izledi
                            </p>
                            @if (!string.IsNullOrWhiteSpace(y.Yorum))
                            {
                                <p class="yorum-metin">@y.Yorum</p>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    </div>

    <aside class="detay-sag">
        <div class="mekan-karti">
            <h3>Mekan</h3>
            <p class="mekan-ad">@Model.MekanAdi</p>
            @if (!string.IsNullOrEmpty(Model.Sehir))
            {
                <p class="mekan-sehir">📍 @Model.Sehir</p>
            }
            <div class="mekan-ozellik">
                <span>🚇 Toplu taşımaya yakın</span>
                <span>♿ Engelli erişimi mevcut</span>
                <span>🅿️ Ücretli otopark</span>
            </div>

            @if (Model.MekandakiDigerEtkinlikler.Any())
            {
                <div class="mekan-diger">
                    <h4>Bu mekandaki diğer etkinlikler</h4>
                    <ul class="mekan-diger-liste">
                        @foreach (var e in Model.MekandakiDigerEtkinlikler)
                        {
                            <li>
                                <a asp-controller="Etkinlik" asp-action="Detay" asp-route-id="@e.Id">
                                    <span class="mekan-diger-ad">@e.Ad</span>
                                    <span class="mekan-diger-tarih">@e.Tarih.ToString("dd MMM yyyy")</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Mekan))
            {
                <a class="btn btn-outline-secondary btn-sm w-100 mt-2"
                   asp-controller="Mekan" asp-action="Detay" asp-route-mekan="@Model.Mekan">
                    🏛️ Mekan sayfasına git
                </a>
            }
        </div>
    </aside>
</div>

@if (Model.BenzerEtkinlikler.Any())
{
    <section class="detay-blok">
        <div class="section-head">
            <h2>Benzer Etkinlikler</h2>
        </div>
        <div class="event-grid">
            @foreach (var e in Model.BenzerEtkinlikler)
            {
                <partial name="_EtkinlikKarti" model="e" />
            }
        </div>
    </section>
}
