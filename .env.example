# Bu dosyayı ".env" olarak kopyalayıp gerçek değerleri girin.
# ".env" dosyası .gitignore'da — asla commit edilmez.

# SQL Server "sa" kullanıcısı için güçlü bir parola (en az 8 karakter, büyük/küçük harf, rakam, sembol içermeli)
DB_SA_PASSWORD=Guclu-Bir-Parola123!

# Stripe test secret key (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_veya_rk_test_ile_baslayan_anahtariniz

# Bilet QR kodlarının imza anahtarı. Uzun ve rastgele olmalı; değiştirilirse
# daha önce gönderilmiş biletlerin QR kodları geçersiz olur.
GIRIS_IMZA_ANAHTARI=uzun-ve-rastgele-bir-deger-uretin

# Yönetici hesabı. Tanımlı değilse hesap oluşturulmaz ve panele girilemez.
YONETICI_EPOSTA=yonetici@ornek.com
YONETICI_SIFRE=Guclu-Bir-Yonetici-Sifresi123!
